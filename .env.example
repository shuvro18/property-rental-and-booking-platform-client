# Better Auth Configuration
BETTER_AUTH_SECRET=your_better_auth_secret_key_here
BETTER_AUTH_URL=http://localhost:3000

# MongoDB Database Connection
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/property-assignment?retryWrites=true&w=majority

# Google OAuth (Social Login)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Backend REST API Server URL
NEXT_PUBLIC_SERVER_URL=http://localhost:5000

# ImgBB API Key (Image Uploads)
NEXT_PUBLIC_IMG_API=your_imgbb_api_key

# Stripe Payment Gateway
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
